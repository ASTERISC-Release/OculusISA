and t0, t0, t1 # clear VS bits
li t1, 0x200
or t0, t0, t1 # set VS = Initial (01)
csrw mstatus, t0
csrw vtype, x0 # vector-state‑changing instruction
csrr t4, mstatus
li t5, 0x600
and t6, t4, t5
mv a0, t6
# Result: a0 = 0x600

# Extension Must Be Active: NONE
