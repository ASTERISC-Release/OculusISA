csrr t0, mseccfg
li t1, 0x1
or t0, t0, t1
csrw mseccfg, t0
li t0, 0x8f
csrw pmpcfg0, t0
csrw pmpaddr0, x0
li t0, 0x20000000
csrw pmpaddr1, t0
call machine_to_supervisor
li t0, 0x7ffffffc
sw x0, 0(t0)
# Result: mcause = 11

