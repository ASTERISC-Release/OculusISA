not a7, a7
and t0, t0, a7 # clear old SXL/UXL
or t0, t0, t6 # set new SXL/UXL
csrw mstatus, t0
csrr x9, mstatus
srli x9, x9, 34
and x9, x9, t3 # extract SXL field
mv a0, x9 # a0 should equal MXL
# Result: a0 = 2

