# Many important RISC-V extensions are currently active.
# Test Case Name: mstatus
# Test Case Type: REGISTER
# Test Case Rule: RULE 53: In the mstatus register, the SXL and UXL fields are WARL fields that control the XLEN for S-mode and U-mode, respectively, on RV64 harts.
##### ASSEMBLY #####
csrr t0, mstatus
li t1, 0xf
slli t1, t1, 32
li t2, 0xffffffffffffffff
xor t2, t2, t1
and t0, t0, t2
