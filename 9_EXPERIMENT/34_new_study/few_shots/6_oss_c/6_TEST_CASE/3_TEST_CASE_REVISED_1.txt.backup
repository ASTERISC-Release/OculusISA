##### ASSEMBLY #####
li t0, 0x1 # t0 = MML bit (bit 0)
csrr t1, mseccfg
or t1, t1, t0
csrw mseccfg, t1 # Set MML = 1
csrw pmpaddr0, x0 # pmpaddr0 = 0 (bottom)
li t2, 0xffffffffffffffff
csrw pmpaddr1, t2 # pmpaddr1 = -1 (top) => covers all addresses
li t3, 0x80 # L bit = 1 at bit 7
csrw pmpcfg0, t3 # pmpcfg0 = L=1, other fields zero
auipc t4, 0
addi t4, t4, 4
li t5, 0x1234
sw t5,0(t4) # memory write succeeds in M-mode
call machine_to_supervisor
auipc t6, 0
addi t6, t6, 4
lw a7,0(t6) # expected to trap (load access fault)
# Result: mcause = 15

